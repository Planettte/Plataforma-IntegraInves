@if (Href is not null)
{
    <a class="boton @ClaseVariante" href="@Href">@ChildContent</a>
}
else
{
    <button type="@Tipo" class="boton @ClaseVariante" disabled="@(Deshabilitado || Cargando)" @onclick="AlActivar">
        @if (Cargando)
        {
            <span class="boton-giro" aria-hidden="true"></span>
            @TextoCargando
        }
        else
        {
            @ChildContent
        }
    </button>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string Variante { get; set; } = "primario";

    [Parameter] public string Tipo { get; set; } = "button";

    [Parameter] public bool Deshabilitado { get; set; }

    [Parameter] public bool Cargando { get; set; }

    [Parameter] public string TextoCargando { get; set; } = "Guardando…";

    [Parameter] public string? Href { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> AlActivar { get; set; }

    private string ClaseVariante => Variante switch
    {
        "secundario" => "boton-secundario",
        "peligro" => "boton-peligro",
        _ => "boton-primario"
    };
}
