@implements IDisposable
@inject NavigationManager Navegacion

<nav class="barra-herramienta" aria-label="Hojas de vida">
    <a href="/">Volver al inicio</a>
    <NavLink href="/estudios-clinicos/hojas-de-vida" Match="NavLinkMatch.All">Personas</NavLink>
    @if (Id is Guid id)
    {
        <NavLink href="@($"/estudios-clinicos/hojas-de-vida/{id}/editor")" Match="NavLinkMatch.All">Editor</NavLink>
        <NavLink href="@($"/estudios-clinicos/hojas-de-vida/{id}/soportes")" Match="NavLinkMatch.All">Soportes</NavLink>
        <NavLink href="@($"/estudios-clinicos/hojas-de-vida/{id}/historial")" Match="NavLinkMatch.All">Historial</NavLink>
    }
    else
    {
        <span class="nav-inactiva">Editor</span>
        <span class="nav-inactiva">Soportes</span>
        <span class="nav-inactiva">Historial</span>
    }
</nav>

@code {
    private Guid? Id { get; set; }

    protected override void OnInitialized()
    {
        Leer();
        Navegacion.LocationChanged += AlCambiar;
    }

    private void AlCambiar(object? sender, LocationChangedEventArgs e)
    {
        Leer();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Leer()
    {
        var ruta = Navegacion.ToBaseRelativePath(Navegacion.Uri).Split('?', '#')[0].Trim('/');
        var partes = ruta.Split('/', StringSplitOptions.RemoveEmptyEntries);
        Id = partes.Length >= 3 && Guid.TryParse(partes[2], out var id) ? id : null;
    }

    public void Dispose()
    {
        Navegacion.LocationChanged -= AlCambiar;
    }
}
