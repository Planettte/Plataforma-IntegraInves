@implements IDisposable
@inject NavigationManager Navegacion

<nav class="barra-herramienta" aria-label="Estudios">
    <a href="/">Volver al inicio</a>
    <NavLink href="/comite/estudios" Match="NavLinkMatch.All">Registros</NavLink>
</nav>

@code {
    protected override void OnInitialized() => Navegacion.LocationChanged += AlCambiar;

    private void AlCambiar(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navegacion.LocationChanged -= AlCambiar;
}
