    private IEnumerable<DestinoCita> Destinos()
    {
        if (_idCita is null && !_udd && _dia?.PuedeAsignar == true)
        {
            foreach (var persona in _dia.Personas.Where(item => _elegidas.Contains(Clave(item))))
            {
                yield return new DestinoCita(Clave(persona), persona.Agenda, persona.UsuarioId, persona.Nombre);
            }

            yield break;
        }

        var unico = Destino();
        yield return new DestinoCita(_personaModal, unico.Agenda, unico.UsuarioId, unico.Nombre);
    }

    private IEnumerable<DateOnly> Fechas()
    {
        if (_idCita is not null || !_recurrente)
        {
            yield return _fechaFormulario;
            yield break;
        }

        var veces = Math.Clamp(_veces, 1, 24);
        var intervalo = Math.Max(1, _intervalo);
        for (var indice = 0; indice < veces; indice++)
        {
            yield return _unidad == "meses"
                ? _fechaFormulario.AddMonths(intervalo * indice)
                : _fechaFormulario.AddDays(intervalo * indice);
        }
    }

    private (string Agenda, Guid? UsuarioId, string Nombre) Destino()
    {
        if (_dia?.PuedeAsignar == true)
        {
            var persona = _dia.Personas.FirstOrDefault(item => Clave(item) == _personaModal) ?? _dia.Personas.FirstOrDefault();
            return persona is null
                ? (_dia.AgendaPropia, _dia.UsuarioId, _dia.Persona)
                : (persona.Agenda, persona.UsuarioId, persona.Nombre);
        }

        return (_dia?.AgendaPropia ?? "medicos", _dia?.UsuarioId, _dia?.Persona ?? "");
    }

    private string Valor(string clave) => _campos.TryGetValue(clave, out var valor) ? valor : "";

    private void Escribir(string clave, ChangeEventArgs cambio) => _campos[clave] = cambio.Value?.ToString() ?? "";

    private static string Clave(PersonaAgendaDto persona) => persona.Agenda + "|" + persona.Nombre;

    private static string Fecha(DateTime? valor) => valor?.ToString("yyyy-MM-dd") ?? "";

    private static string EtiquetaAgenda(string agenda) => agenda switch
    {
