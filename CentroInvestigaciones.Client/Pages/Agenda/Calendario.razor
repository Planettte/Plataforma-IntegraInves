    private void AlternarPersona(string clave, ChangeEventArgs evento)
    {
        var marcado = evento.Value is bool valor && valor || string.Equals(evento.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (marcado)
        {
            _elegidas.Add(clave);
        }
        else
        {
            _elegidas.Remove(clave);
        }
    }

    private async Task GuardarAsync()
    {
        if (!_puedeEditar)
        {
            return;
        }

        if (_idCita is null && _dia?.PuedeAsignar == true && (_udd ? string.IsNullOrEmpty(_personaModal) : _elegidas.Count == 0))
        {
            _error = "Selecciona al menos una persona.";
            return;
        }

        if (_recurrente && _elegidas.Count > 1)
        {
            _error = "El registro múltiple es para una sola persona. Elige una o desactiva la repetición.";
            return;
        }

        if (!PuedeGuardar)
        {
            _error = "Abre el archivo de laboratorios o márcalo como revisado.";
            return;
        }

        _guardando = true;
        _error = null;
        var fallos = new List<string>();
        var guardadas = 0;
        try
        {
            foreach (var destino in Destinos())
            {
                if (destino.UsuarioId is null && string.IsNullOrWhiteSpace(destino.Nombre))
                {
                    fallos.Add("Indica la persona.");
                    continue;
                }
                foreach (var fecha in Fechas())
                {
                    try
                    {
                        await Cliente.GuardarCitaAsync(Ambito, _idCita is not null && fecha == _fechaFormulario ? _idCita : null, new GuardarCitaAgendaDto
                        {
                            Agenda = destino.Agenda,
                            Fecha = fecha.ToString("yyyy-MM-dd"),
                            HoraInicio = _horaInicio,
                            HoraFin = _horaFin,
                            Tipo = _udd ? "citas" : _tipo,
                            Importante = _importante,
                            UsuarioId = destino.UsuarioId,
                            Persona = destino.Nombre,
                            Campos = _campos
                        });
                        guardadas++;
                    }
                    catch (Exception excepcion) when (excepcion is InvalidOperationException or HttpRequestException)
                    {
                        fallos.Add($"{destino.Nombre} {fecha:dd/MM/yyyy}: {excepcion.Message}");
                    }
                }
            }

            if (fallos.Count > 0)
            {
                _error = guardadas == 0
                    ? string.Join(" ", fallos)
                    : $"Se guardaron {guardadas}. No se pudieron: {string.Join(" ", fallos)}";
                if (guardadas > 0)
                {
                    await CargarAsync();
                }

                return;
            }

            _borrador = false;
            _editando = false;
            await CargarAsync();
            Avisos.Completado();
        }
        finally
        {
            _guardando = false;
        }
    }

