    private IEnumerable<DateOnly?> CeldasMes()
    {
        var primero = new DateOnly(_fecha.Year, _fecha.Month, 1);
        var desplazamiento = ((int)primero.DayOfWeek + 6) % 7;
        for (var i = 0; i < desplazamiento; i++)
        {
            yield return null;
        }

        for (var dia = 1; dia <= DateTime.DaysInMonth(_fecha.Year, _fecha.Month); dia++)
        {
            yield return new DateOnly(_fecha.Year, _fecha.Month, dia);
        }
    }

    private void AbrirNueva(string hora, string? personaNombre = null)
    {
        if (_borrador && _idCita is null)
        {
            _editando = true;
            _ = CargarPanelAsync();
            return;
        }

        _idCita = null;
        _tipo = "citas";
        _horaInicio = hora;
        _horaFin = HorasFin[Array.IndexOf(Horas, hora)];
        _importante = false;
        _recurrente = false;
        _laboratorioRevisado = false;
        _intervalo = 2;
        _veces = 2;
        _unidad = "dias";
        _fechaFormulario = _fecha;
        _puedeEditar = true;
        _creadoPor = "";
        _personaModal = "";
        _elegidas.Clear();

        _campos = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        _error = null;
        _borrador = true;
        _editando = true;
        _ = CargarPanelAsync();
    }

    private void AbrirEdicion(CitaAgendaDto cita)
    {
        if (_borrador && _idCita == cita.Id)
        {
            _editando = true;
            _ = CargarPanelAsync();
            return;
        }

        var persona = _dia?.Personas.FirstOrDefault(item =>
            item.Agenda == cita.Agenda && string.Equals(item.Nombre, cita.Persona, StringComparison.OrdinalIgnoreCase));
        _idCita = cita.Id;
        _tipo = cita.Tipo;
        _horaInicio = cita.HoraInicio;
        _horaFin = cita.HoraFin;
        _importante = cita.Importante;
        _recurrente = false;
        _laboratorioRevisado = false;
        _fechaFormulario = DateOnly.TryParse(cita.Fecha, out var fechaCita) ? fechaCita : _fecha;
        _puedeEditar = cita.PuedeEditar;
        _creadoPor = cita.CreadoPorPersona;
        _personaModal = persona is null ? "" : Clave(persona);
        _elegidas.Clear();
        if (_personaModal.Length > 0)
        {
            _elegidas.Add(_personaModal);
        }

        _campos = new Dictionary<string, string>(cita.Campos, StringComparer.OrdinalIgnoreCase);
        _error = null;
        _borrador = cita.PuedeEditar;
        _editando = true;
        _ = CargarPanelAsync();
    }

    private async Task CargarPanelAsync()
    {
        _cargandoPanel = true;
        try
        {
            if (_fechaFormulario == _fecha && (_udd || _dia?.PuedeAsignar != true))
            {
                _citasPanel = _dia?.Citas.ToList() ?? [];
                return;
            }

            var dia = await Cliente.DiaAsync(Ambito, _fechaFormulario, false, asignadas: _dia?.PuedeAsignar == true && !_udd);
            _citasPanel = dia.Citas.ToList();
        }
        catch (HttpRequestException)
        {
            _citasPanel = _dia?.Citas.ToList() ?? [];
        }
        finally
        {
            _cargandoPanel = false;
            await InvokeAsync(StateHasChanged);
        }
    }

