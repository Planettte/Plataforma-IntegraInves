@page "/"
@inject EstadoSesion Estado
@inject ClienteNucleo Nucleo
@inject Avisos Avisos

<EncabezadoPagina Titulo="Inicio" Descripcion="Recordatorios y herramientas a las que tienes acceso." Icono="inicio" />

@if (_error is not null)
{
    <Alerta Tipo="peligro" Mensaje="@_error" />
}

<section class="panel-dashboard panel-dashboard-tres">
    <div class="tarjeta-dashboard">
        <div class="tarjeta-dashboard-cabecera">
            <span class="icono-solido"><IconoHerramienta Nombre="campana" /></span>
            <div>
                <h2>Notificaciones</h2>
                <p>Avisos de tus herramientas.</p>
            </div>
            @if (Pendientes > 0)
            {
                <span class="cuenta-roja">@Pendientes</span>
            }
        </div>
        <div class="tarjeta-dashboard-scroll">
            @if (_cargando)
            {
                <Cargando />
            }
            else if (_notificaciones.Count == 0)
            {
                <div class="aviso-vacio">
                    <svg viewBox="0 0 80 80" aria-hidden="true">
                        <path d="M28 18l2 4M52 18l-2 4M40 12v5" />
                        <path d="M24 46V36a16 16 0 1 1 32 0v10l4 6H20z" />
                        <path d="M34 56a6 6 0 0 0 12 0" />
                    </svg>
                    <p>No hay notificaciones todavía.</p>
                </div>
            }
            else
            {
                <ul class="lista-notificaciones">
                    @foreach (var item in _notificaciones)
                    {
                        <li class="@(item.Vista ? "vista" : null)" @onmouseover="() => VerNotificacionAsync(item)" @onclick="() => VerNotificacionAsync(item)">
                            @if (EnlaceInterno.EsRuta(item.Enlace))
                            {
                                <a class="notificacion-ir" href="@item.Enlace">
                                    @CuerpoNotificacion(item)
                                </a>
                            }
                            else
                            {
                                @CuerpoNotificacion(item)
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="tarjeta-dashboard">
        <div class="tarjeta-dashboard-cabecera">
            <span class="icono-solido"><IconoHerramienta Nombre="nota" /></span>
            <div>
                <h2>Mis notas</h2>
                <p>Recordatorios personales. Solo tú los ves.</p>
            </div>
            <Boton Variante="secundario" AlActivar="NuevaNota">Nueva</Boton>
        </div>
        <div class="tarjeta-dashboard-scroll">
            @if (_editando)
            {
                <div class="hoja-nota">
                    <div class="campo">
                        <label for="nota-titulo">Título</label>
                        <input id="nota-titulo" class="entrada" @bind="_tituloNota" maxlength="160" />
                    </div>
                    <div class="campo">
                        <label for="nota-contenido">Contenido</label>
                        <textarea id="nota-contenido" class="entrada area-texto" rows="4" @bind="_contenidoNota" maxlength="4000"></textarea>
                    </div>
                    <div class="acciones-fila">
                        <Boton Deshabilitado="@(!NotaValida)" Cargando="_guardandoNota" AlActivar="GuardarNota">Guardar</Boton>
                        <Boton Variante="secundario" AlActivar="CancelarNota">Cancelar</Boton>
                    </div>
                </div>
            }
            else if (_notas.Count == 0)
            {
                <div class="aviso-vacio">
                    <svg viewBox="0 0 80 80" aria-hidden="true">
                        <path d="M24 18h22l10 10v34H24z" />
                        <path d="M46 18v10h10" />
                        <path d="M32 40h16M32 48h16M32 56h10" />
                    </svg>
                    <p>No hay notas todavía.</p>
                </div>
            }
            else
            {
                <ul class="lista-notas">
                    @foreach (var nota in _notas)
                    {
                        <li class="nota-tarjeta">
                            <div>
                                <strong>@nota.Titulo</strong>
                                <p>@nota.Contenido</p>
                                <small class="nota-fecha">@FechaNota(nota)</small>
                            </div>
                            <div class="nota-acciones">
                                <Boton Variante="secundario" AlActivar="@(() => EditarNota(nota))">Editar</Boton>
                                <Boton Variante="peligro" AlActivar="@(() => EliminarNota(nota.Id))">Eliminar</Boton>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="tarjeta-dashboard">
        <div class="tarjeta-dashboard-cabecera">
            <span class="icono-solido"><IconoHerramienta Nombre="cuadricula" /></span>
            <div>
                <h2>Mis herramientas</h2>
            </div>
        </div>
        <div class="tarjeta-dashboard-scroll">
            @if (_herramientas.Count == 0)
            {
                <EstadoVacio Mensaje="Aún no tienes herramientas asignadas. Un administrador puede darte acceso." />
            }
            else
            {
                <div class="lista-herramientas">
                    @foreach (var herramienta in _herramientas)
                    {
                        <EnlaceHerramienta Elemento="herramienta" />
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool _cargando = true;
    private bool _editando;
    private bool _guardandoNota;
    private string? _error;
    private Guid? _notaId;
    private string _tituloNota = "";
    private string _contenidoNota = "";
    private IReadOnlyList<ElementoNavegacion> _herramientas = [];
    private IReadOnlyList<NotificacionDto> _notificaciones = [];
    private readonly HashSet<Guid> _vistas = [];

    private int Pendientes => _notificaciones.Count(item => !item.Vista);
    private List<NotaDto> _notas = [];

    private bool NotaValida => !string.IsNullOrWhiteSpace(_tituloNota) && !string.IsNullOrWhiteSpace(_contenidoNota);

    private static string FechaNota(NotaDto nota)
    {
        var fecha = nota.FechaActualizacionUtc ?? nota.FechaCreacionUtc;
        return fecha.ToLocalTime().ToString("d/MM/yyyy HH:mm");
    }

    private async Task VerNotificacionAsync(NotificacionDto item)
    {
        if (item.Vista || item.Id is not Guid id || !_vistas.Add(id))
        {
            return;
        }

        item.Vista = true;
        try
        {
            await Nucleo.MarcarVistaAsync(id);
        }
        catch (HttpRequestException)
        {
            item.Vista = false;
            _vistas.Remove(id);
        }
    }

    private RenderFragment CuerpoNotificacion(NotificacionDto item) => @<text>
        <span class="distintivo">@item.Origen</span>
        <strong>@item.Titulo</strong>
        <p>@item.Mensaje</p>
        <small>@item.FechaUtc.ToLocalTime().ToString("g")</small>
    </text>;

    protected override async Task OnInitializedAsync()
    {
        _herramientas = CatalogoNavegacion.HerramientasVisibles(Estado.Actual.Permisos, Estado.Actual.Cargo);
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        _cargando = true;
        _error = null;
        try
        {
            if (Estado.Actual.EstadoCuenta == "Activo")
            {
                _notificaciones = (await Nucleo.ListarTableroAsync())
                    .Where(item => item.Origen is not ("Anuncio" or "Herramienta"))
                    .ToList();
                _notas = (await Nucleo.ListarNotasAsync()).ToList();
            }
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo cargar el tablero. Comprueba que la API esté en marcha.";
        }
        finally
        {
            _cargando = false;
        }
    }

    private void NuevaNota()
    {
        _editando = true;
        _notaId = null;
        _tituloNota = "";
        _contenidoNota = "";
    }

    private void EditarNota(NotaDto nota)
    {
        _editando = true;
        _notaId = nota.Id;
        _tituloNota = nota.Titulo;
        _contenidoNota = nota.Contenido;
    }

    private void CancelarNota()
    {
        _editando = false;
        _notaId = null;
        _tituloNota = "";
        _contenidoNota = "";
    }

    private async Task GuardarNota()
    {
        if (!NotaValida)
        {
            return;
        }

        _guardandoNota = true;
        _error = null;
        try
        {
            var dto = new GuardarNotaDto { Titulo = _tituloNota.Trim(), Contenido = _contenidoNota.Trim() };
            if (_notaId is Guid id)
            {
                await Nucleo.ActualizarNotaAsync(id, dto);
            }
            else
            {
                await Nucleo.CrearNotaAsync(dto);
            }

            CancelarNota();
            _notas = (await Nucleo.ListarNotasAsync()).ToList();
            Avisos.Completado();
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo guardar la nota.";
        }
        finally
        {
            _guardandoNota = false;
        }
    }

    private async Task EliminarNota(Guid id)
    {
        _error = null;
        try
        {
            await Nucleo.EliminarNotaAsync(id);
            _notas = (await Nucleo.ListarNotasAsync()).ToList();
            Avisos.Completado();
            if (_notaId == id)
            {
                CancelarNota();
            }
        }
        catch (HttpRequestException)
        {
            _error = "No se pudo eliminar la nota.";
        }
    }
}
